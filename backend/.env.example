# Path to the Firebase service-account JSON (download from Firebase console → Service accounts). NEVER commit it.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FIREBASE_PROJECT_ID=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25

# --- Media storage (app/core/storage.py): local | s3 | firebase ---
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./uploads
MEDIA_SIGNING_SECRET=               # long random string (python -c "import secrets;print(secrets.token_hex(32))"); never commit
PUBLIC_BASE_URL=http://localhost:8000
# s3 = any S3-compatible store: Backblaze B2, Cloudflare R2, MinIO, AWS S3. Keep the bucket PRIVATE.
S3_BUCKET=
S3_ENDPOINT_URL=                    # e.g. https://s3.us-west-004.backblazeb2.com (empty for AWS S3)
S3_REGION=                          # e.g. us-west-004
S3_ACCESS_KEY_ID=                   # an application key limited to this bucket; never commit
S3_SECRET_ACCESS_KEY=
# firebase = Firebase Storage (Blaze plan)
FIREBASE_STORAGE_BUCKET=            # e.g. my-project.firebasestorage.app

# --- Strands Decider agent (see ../README.md) ---
DECIDER_API_KEY=                    # team key from awsugmdu.in (never commit)
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
AWS_REGION=us-east-1
SHIP_MODEL=us.amazon.nova-2-lite-v1:0
# Bedrock credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN, or AWS_PROFILE, or AWS_BEARER_TOKEN_BEDROCK
