# Firebase web app config (public identifiers, NOT secrets). Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
# Set to true to preview the feed with clearly-labelled DEMO posts while the posts API (Phase 3) doesn't exist yet
VITE_DEMO_DATA=false
